# Public web push certificate key from Firebase Console (not firebaseConfig.apiKey).
VITE_FIREBASE_VAPID_KEY=
# Set to vercel only after deploying /api/notification-events with server credentials.
VITE_NOTIFICATION_BACKEND=
# Vercel SERVER environment only. Paste the service-account JSON in Vercel,
# never in this committed example and never in a VITE_ variable.
# FIREBASE_SERVICE_ACCOUNT_JSON=
# Enable ONLY after deploying the rules and backend for this feature.
VITE_ENABLE_WEBSITE_PERIODS=false
